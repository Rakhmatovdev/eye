# Server-side target used by the Next.js /api rewrite.
BACKEND_URL=http://localhost:8080

# Optional. Enables the Yandex Maps provider on /map. The key is intentionally
# public in the browser bundle; restrict it to your site origins in Yandex's
# developer console.
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# Optional direct API/WebSocket overrides. Leave blank for the normal local setup.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=
